# 模型 / 素材 / 工程文件一律按二进制处理：
# 有些 FBX 是 ASCII 的，但换行转换一样会改内容，克隆出来就对不上原始文件了。
*.fbx   binary
*.abc   binary
*.glb   binary
*.gltf  binary
*.obj   binary
*.bgeo  binary
*.hip   binary
*.hipnc binary
*.otl   binary
*.hda   binary
*.exr   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.tif   binary
*.zip   binary

# 文本文件统一按 LF 存
*.py    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.ps1   text eol=lf
